# Copy to live.local.env (git-ignored) and fill in values from YOUR tenant.
# Never commit tenant, client, capacity or group identifiers.
FABRICOPS_MODE=live
FABRIC_TENANT_ID=<entra-tenant-guid>
FABRIC_CLIENT_ID=<federated-app-client-guid>
FABRIC_CAPACITY_NONPROD=<fabric-capacity-guid>
FABRIC_CAPACITY_PROD=<fabric-capacity-guid>
# Maps config group refs to Entra group object IDs: FABRIC_REF_<REF_UPPER_SNAKE>
FABRIC_REF_FABRIC_PLATFORM_ADMINS=<group-object-guid>
FABRIC_REF_CARE_DATA_ENGINEERS=<group-object-guid>
FABRIC_REF_CARE_OPERATIONS_CONSUMERS=<group-object-guid>
# Local development with an `az login` session only
FABRICOPS_ALLOW_AZURE_CLI=1
# Mutation additionally requires --apply and:
# FABRICOPS_ALLOW_LIVE_MUTATION=1
